# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# digital signature certs (ASLA commit etme)
*.p12
*.pfx
rapor-imza.p12

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code yerel ayarları (IDE'ye özel, kişisel)
.claude/settings.local.json
.claude/launch.json

# Lab-CRM ayrı proje — kendi repo'sunda yönetilmeli
app/(dashboard)/laboratuvar/lab-crm/

# DB çıktıları ve geçici dosyalar
**/db-output*.txt
**/*.txt
**/Untitled-*
tmp/
.tmp/

# MSSQL/MySQL dump dosyaları — 250+ MB, repo'da yer kaplar
migrations/massgrup_*.sql
migrations/mysql-out/
migrations/*-export.sql
migrations/*-dump.sql
dev*.log
.next-dev*.log
data/*.local.json

# Geliştirici scriptleri (üretimde gereksiz)
**/inspect_db*.js
**/verify-auth.js
gen_onboarding.js
portal/

# Geçici/debug scriptler ve veri dökümleri (underscore prefix konvansiyonu)
scripts/_*
# Scratch export çıktıları (PDF/örnek dosyalar)
export/
# Kazara oluşan kopya dosyalar (" copy.tsx" vb.)
**/*\ copy.*
