# ÜGD Portal — Ortam Değişkenleri
# Bu dosyayı kopyalayıp .env.local adıyla kaydedin ve değerleri doldurun.
# cp .env.example .env.local

# ─── Veritabanı (MSSQL) ────────────────────────────────────────────
DB_SERVER=192.168.x.x
DB_NAME=PortalDB
DB_USER=sa
DB_PASSWORD=

# ─── Auth (next-auth) ──────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=   # openssl rand -base64 32 ile üretin

# ─── Rapor dijital imza (tamper-proof) ─────────────────────────────
# Onaylı raporun içeriğini HMAC-SHA256 ile imzalar. Üretimde MUTLAKA tanımlayın
# ve SABİT tutun (değişirse eski raporların imzası "bozuk" görünür).
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
RAPOR_IMZA_SECRET=
# Karekod doğrulama public adresi (opsiyonel — varsayılan https://uniqueanalyse.com)
NEXT_PUBLIC_DOGRULAMA_URL=https://uniqueanalyse.com

# ─── İmzalı PDF (PAdES — PDF'e gömülü dijital imza) ────────────────
# PDF'i kurcalamaya karşı korur (editlenince imza geçersiz olur, Adobe uyarır).
# Self-signed köprü sertifikası üretmek için:  node scripts/gen-imza-cert.mjs
# Bulut e-Mühür gelince signer değiştirilir.
RAPOR_IMZA_P12_BASE64=
RAPOR_IMZA_P12_PASS=

# ─── E-posta (nodemailer) ──────────────────────────────────────────
# Admin > Ayarlar panelinden de yönetilebilir
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=portal@ugd.com.tr

# Eurolab ayrı PostgreSQL veritabanı
# Vercel canlı ortamında bu değer tanımlı olmalı; local JSON fallback yalnızca geliştirme içindir.
EUROLAB_POSTGRES_URL=postgres://user:password@host:5432/database
